<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.hermes.companion.refresh</string>
		<string>com.hermes.companion.sync</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Hermes Companion</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>Hermes Companion reads your sleep stages, workouts, heart rate, and daily activity from Apple Health so your Hermes companion agent can understand your physical recovery, workout status, and sleep quality.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Hermes Companion connects to Apple Health to synchronize your health telemetry with your personal companion.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Hermes Companion needs location access at all times to report your position and trigger companion automations even when the app is closed or running in the background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Hermes Companion needs continuous location access even when the app is closed to record significant movements and wake up on arrivals/departures.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Hermes Companion needs your location to provide accurate companion updates and map your coordinates.</string>
	<key>NSMotionUsageDescription</key>
	<string>Hermes Companion reads motion activity (stationary, walking, running, driving) so your companion agent knows whether you are moving right now, even when the location fix is a few minutes old.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.hermes.HermesCompanion</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Hermes Companion</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
